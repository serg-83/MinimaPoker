d var(--gold);\n    -webkit-backdrop-filter: blur(12px);\n    backdrop-filter: blur(12px);\n    border-radius: 0;\n    transform: none;\n    max-width: none;\n    box-sizing: border-box;\n}\n\n.action-btn {\n    padding: 10px 18px;\n    font-size: 1rem;\n    font-weight: bold;\n    border: none;\n    border-radius: 25px;\n    cursor: pointer;\n    transition: all 0.15s;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    box-shadow: 0 3px 0 rgba(0,0,0,0.3);\n    min-width: 80px;\n    flex: 1 1 auto;\n    max-width: 140px;\n    font-family: 'Montserrat', 'Segoe UI', Arial, sans-serif;\n    color: white;\n}\n\n.action-btn.fold  { background: linear-gradient(145deg, #c0392b, #96281b); }\n.action-btn.call  { background: linear-gradient(145deg, #27ae60, #1e8449); }\n.action-btn.raise { background: linear-gradient(145deg, #f39c12, #d68910); }\n.action-btn.check { background: linear-gradient(145deg, #3498db, #2471a3); }\n\n.action-btn:hover:not(:disabled) {\n    transform: translateY(-2px);\n    filter: brightness(1.1);\n    box-shadow: 0 5px 0 rgba(0,0,0,0.3);\n}\n\n.action-btn:active:not(:disabled) {\n    transform: translateY(1px);\n    box-shadow: 0 1px 0 rgba(0,0,0,0.3);\n}\n\n.action-btn:disabled {\n    opacity: 0.4;\n    cursor: not-allowed;\n    transform: none;\n}\n\n/* ===== PHASE CONTROLS ===== */\n#phase-controls {\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    z-index: 30;\n    background: rgba(0,0,0,0.75);\n    padding: 8px 14px;\n    border-radius: 20px;\n    border: 1px solid var(--gold);\n    color: white;\n    font-size: 0.85rem;\n    -webkit-backdrop-filter: blur(5px);\n    backdrop-filter: blur(5px);\n    max-width: 200px;\n}\n\n#phase-controls button.primary {\n    background: var(--gold);\n    color: #000;\n    border: none;\n    padding: 6px 14px;\n    border-radius: 20px;\n    font-weight: bold;\n    cursor: pointer;\n    margin-left: 8px;\n    font-size: 0.85rem;\n}\n\n/* ===== CHANNEL STATUS ===== */\n#channel-status {\